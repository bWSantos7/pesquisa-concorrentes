# =====================================================================
# Variáveis de ambiente — App de Pesquisa de Concorrentes
# Copie para .env.local em desenvolvimento e preencha com os valores do seu
# projeto Supabase. Em produção (Railway), cadastre-as em
# Service → Variables — nunca commitar .env.local nem a Service Role Key.
# =====================================================================

# --- Obrigatórias em build E runtime (o Next.js embute as NEXT_PUBLIC_*
#     no bundle do navegador durante `next build`; no Railway, garanta que
#     já estejam cadastradas no serviço ANTES do primeiro deploy) ---

# URL do projeto Supabase (pública).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anônima (pública, segura no navegador — sujeita a RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# --- Obrigatória apenas em runtime, somente servidor (SECRETA) ---

# Chave de service role — NUNCA expor ao navegador. Ignora RLS.
# Usada no fluxo do agente (sem sessão Auth) e nos scripts de seed.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Usadas apenas ao rodar `npm run seed:agentes` manualmente
#     (local ou via `railway run`) — não são necessárias para o app subir ---

GESTOR_EMAIL=gestor@exemplo.com
GESTOR_SENHA=troque-esta-senha
GESTOR_NOME=Gestor Padrão

# --- Não configurar manualmente ---
# PORT é injetada automaticamente pelo Railway; o script "start" já lê
# process.env.PORT (next start -p ${PORT:-3000}).
